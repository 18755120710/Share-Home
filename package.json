{
  "name": "share-home",
  "version": "1.0.14",
  "description": "安全、无压缩的局域网零阻碍点对点极速传输与公共落盘共享空间",
  "bin": {
    "share-home": "bin/cli.js"
  },
  "preferGlobal": true,
  "files": [
    "bin/",
    ".next/",
    "!.next/dev/",
    "!.next/cache/",
    "public/",
    "package.json",
    "README.md",
    "src/services/",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "pkill -f 'next-dev-server' 2>/dev/null || true; pkill -f 'next dev' 2>/dev/null || true; next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -p 8301",
    "lint": "eslint"
  },
  "dependencies": {
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "bonjour-service": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-docx": "^1.8.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
